# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/dist

# caches
.eslintcache
.turbo
.cache
*.tsbuildinfo

# env files (secrets) — keep an example file if one is added
.env*
!.env.example

# vercel / netlify
.vercel
.netlify

# typescript
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# certificates and keys
*.pem
*.key

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# local tooling
.claude/settings.local.json

# temporary files
*.tmp
*.bak
